{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/fence.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/entry.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/entry.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/entry.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/entry.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
