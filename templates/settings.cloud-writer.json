{
  "_comment": "The permissions block tools/settings.mjs adds with -Set cloud-writer (0.3.0): a cloud session that writes a branch on a work repository, where nobody is there to click. allow: stage and commit, push a claude/* branch, fetch, open a pull request and set it to merge on green, run the vendored kit; no rebase and no repository script. deny: the pc set's deny rows (templates/root-settings.json), then every one of its ask rows as a deny row: an ask with no human is a hang, and a denied install ends in an honest BLOCKED line instead. No ask key, ever: tools/settings.mjs refuses a cloud set that carries one.",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git fetch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge --auto *)",
      "Bash(node .claude/kit/*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/credentials.json)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(cargo add *)",
      "Bash(gh repo delete *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(pnpm add *)",
      "PowerShell(yarn add *)",
      "PowerShell(pip install *)",
      "PowerShell(uv add *)",
      "PowerShell(cargo add *)",
      "PowerShell(gh repo delete *)",
      "Bash(npm install)",
      "Bash(cargo install *)",
      "Bash(uv sync)",
      "PowerShell(npm install)",
      "PowerShell(cargo install *)",
      "PowerShell(uv sync)",
      "Bash(npm add *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(py -m pip install *)",
      "Bash(bun add *)",
      "Bash(go get *)",
      "Bash(poetry add *)",
      "Bash(dotnet add package *)",
      "PowerShell(npm add *)",
      "PowerShell(pip3 install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(python3 -m pip install *)",
      "PowerShell(py -m pip install *)",
      "PowerShell(bun add *)",
      "PowerShell(go get *)",
      "PowerShell(poetry add *)",
      "PowerShell(dotnet add package *)"
    ]
  }
}
