#!/bin/sh
# design-first law-claim shim (VCS-23). Copy this file to <brain>/.git/hooks/commit-msg.
# Git runs it with the path of the commit message file. It finds the kit through the pointer
# (%USERPROFILE%\.claude\design-first.json, or DF_POINTER_PATH) and runs tools/vcs/law-claim.ps1,
# which refuses a commit that changes a law file with no claim and no "No-Claim: <reason>" line.
# The shim never refuses on its own: when pwsh, the pointer or the kit script is missing it says
# so on stderr and lets the commit through. Adopt does not install this file and ships no claim
# for it; add the two claims in tools/MANUAL.md (The commit check) and the Doctor proves it is
# installed.
command -v pwsh >/dev/null 2>&1 || { echo "design-first law-claim: pwsh is not on PATH; VCS-23 was NOT checked" >&2; exit 0; }
DF_COMMIT_MSG_FILE="$1" exec pwsh -NoProfile -Command '
$ErrorActionPreference = "Stop"
try {
    $p = if ($env:DF_POINTER_PATH) { $env:DF_POINTER_PATH } else { Join-Path $env:USERPROFILE ".claude\design-first.json" }
    if (-not (Test-Path -LiteralPath $p -PathType Leaf)) { throw "no pointer at $p" }
    $kit = [string](Get-Content -LiteralPath $p -Raw | ConvertFrom-Json).pluginRoot
    $script = Join-Path $kit "tools\vcs\law-claim.ps1"
    if (-not (Test-Path -LiteralPath $script -PathType Leaf)) { throw "no tools\vcs\law-claim.ps1 under $kit" }
} catch {
    [Console]::Error.WriteLine("design-first law-claim: " + $_.Exception.Message + "; VCS-23 was NOT checked")
    exit 0
}
& $script -MessageFile $env:DF_COMMIT_MSG_FILE
exit $LASTEXITCODE
'
