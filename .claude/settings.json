{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git fetch *)",
      "Bash(git rebase origin/main)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge --auto *)",
      "Bash(node .claude/kit/*)",
      "Bash(node scripts/*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/credentials.json)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(cargo add *)",
      "Bash(gh repo delete *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(pnpm add *)",
      "PowerShell(yarn add *)",
      "PowerShell(pip install *)",
      "PowerShell(uv add *)",
      "PowerShell(cargo add *)",
      "PowerShell(gh repo delete *)",
      "Bash(npm install)",
      "Bash(cargo install *)",
      "Bash(uv sync)",
      "PowerShell(npm install)",
      "PowerShell(cargo install *)",
      "PowerShell(uv sync)",
      "Bash(npm add *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(py -m pip install *)",
      "Bash(bun add *)",
      "Bash(go get *)",
      "Bash(poetry add *)",
      "Bash(dotnet add package *)",
      "PowerShell(npm add *)",
      "PowerShell(pip3 install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(python3 -m pip install *)",
      "PowerShell(py -m pip install *)",
      "PowerShell(bun add *)",
      "PowerShell(go get *)",
      "PowerShell(poetry add *)",
      "PowerShell(dotnet add package *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/fence.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/ask.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|mcp__ccd_session__start_session|mcp__claude-code-remote__create_session|mcp__claude-code-remote__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/agent.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/card.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/route.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/stop.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/subagent.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/entry.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/entry.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/entry.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/kit/hooks/entry.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
